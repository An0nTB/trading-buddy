              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Rule compliance: share of trades where all of the card’s criteria are ticked. Effect: expectancy per trade with the criterion minus without; below %lld trades per side, descriptive only."
