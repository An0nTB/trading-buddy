    "Netto nach Kosten je Gruppe im gewählten Zeitraum. Wochentag und Stunde nach der Eröffnung in deiner Zeitzone. Unter %lld Trades je Gruppe beschreibt die Zahl nur." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Net after costs per group in the selected period. Weekday and hour by opening time in your time zone. Below %lld trade per group, the number is descriptive only."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Net after costs per group in the selected period. Weekday and hour by opening time in your time zone. Below %lld trades per group, the number is descriptive only."
                }
              }
            }
          }
        }
      }
    },
    "Netto nach Kosten, aufsummiert je Trade im gewählten Zeitraum. Start bei 0, weil der Auszug kein Startkapital kennt." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net after costs, summed per trade in the selected period. Starts at 0 because the statement knows no starting capital."
          }
        }
      }
    },
    "Netto regeltreu %@, mit Regelbruch %@. Rote Punkte sind Trades mit Verstoß gegen eigene oder Prop-Firm-Regeln; gezählt im gewählten Zeitraum." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Netto regeltreu %1$@, mit Regelbruch %2$@. Rote Punkte sind Trades mit Verstoß gegen eigene oder Prop-Firm-Regeln; gezählt im gewählten Zeitraum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net rule-compliant %1$@, with rule breach %2$@. Red dots are trades violating your own or prop firm rules; counted in the selected period."
          }
        }
      }
    },
