        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Rule compliance: share of trades where all of the card’s criteria are ticked. Effect: expectancy per trade with the criterion minus without; below %lld trade per side, descriptive only."
