    },
    "Die Datei ist keine lesbare Sicherung und wird nicht eingespielt. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is not a readable backup and will not be restored. %@"
