    },
    "„%@“ ist kein unterstütztes Bild. Möglich sind PNG, JPEG und HEIC." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is not a supported image. PNG, JPEG and HEIC are possible."
          }
        }
      }
    },
    "„%@“ ließ sich nicht in den Bilderordner kopieren." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” could not be copied to the image folder."
          }
        }
      }
    },
    "„%@“: Dateiformat %lld kennt diese Version nicht." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "new",
