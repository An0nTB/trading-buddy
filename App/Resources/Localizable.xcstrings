      }
    },
    "Henry öffnet Claude Desktop mit deiner Frage. Du schickst sie dort selbst ab, die Zahlen holt sich Claude über den Connector. Im Link stehen nur Konto-Endziffern, Zeitraum und Instrument, keine Beträge und keine Notizen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henry opens Claude Desktop with your question. You send it there yourself; Claude fetches the numbers through the connector. The link contains only the last digits of the account, the period and the instrument, no amounts and no notes."
          }
        }
      }
    },
    "heute" : {
      "localizations" : {
        "en" : {
