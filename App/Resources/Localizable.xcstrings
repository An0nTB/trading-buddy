    },
    "Alle Beträge in Kontowährung %@. Die App zeigt Summen derzeit in %@, die Zahlen dort weichen deshalb ab." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All amounts in account currency %1$@. The app currently shows totals in %2$@, so the figures there differ."
