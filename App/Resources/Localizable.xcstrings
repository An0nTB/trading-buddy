    },
    "Vorgänge mit anderen Werten als beim früheren Import: %@. Bei MetaTrader und XTB: Stimmt die Serverzeit mit dem letzten Import überein?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
