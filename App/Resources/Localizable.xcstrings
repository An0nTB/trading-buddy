          "stringUnit" : {
            "state" : "translated",
            "value" : "Notify after automatic import"
          }
        }
      }
    },
    "US-Ostküste (Annahme, in den IBKR-Einstellungen änderbar); die App zeigt deine Zeitzone" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
